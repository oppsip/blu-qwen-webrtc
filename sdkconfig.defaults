# =============================================================
# blu-qwen-webrtc P0 baseline — ESP32-WROVER-E (8MB flash, 8MB PSRAM)
# =============================================================

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Custom single-app table (see partitions.csv): the image with classic BT,
# WiFi and esp_peer exceeds the default 1.5 MB factory partition.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# P0 memory experiment: route allocations above 4 KB to PSRAM (default 16 KB).
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_ESP_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# esp_peer needs DTLS-SRTP; IDFv6.0+ also needs X.509 creation for the DTLS certificate.
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
CONFIG_MBEDTLS_X509_CREATE_C=y

# Classic BT: production uses the HFP client role (device = HF, phone = AG).
# AG, A2DP and AVRCP are not on the call path and are disabled for the P0 budget.
CONFIG_BT_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_HFP_ENABLE=y
CONFIG_BT_HFP_CLIENT_ENABLE=y
CONFIG_BT_HFP_AG_ENABLE=n
CONFIG_BT_HFP_AUDIO_DATA_PATH_HCI=y
CONFIG_BT_HFP_WBS_ENABLE=y
CONFIG_BT_PBAC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=n
CONFIG_BT_AVRCP_ENABLED=n
# Dual mode: classic HFP + BLE GATTS provisioning (as in production).
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=1
CONFIG_BTDM_CTRL_BR_EDR_SCO_DATA_PATH_HCI=y
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_BT_BLUEDROID_ESP_COEX_VSC=y

# SCO TX pump runs on esp_timer; keep it off the WiFi/lwIP core (CPU0).
# CONFIG_ESP_TIMER_TASK_AFFINITY_CPU0 is not set
CONFIG_ESP_TIMER_TASK_AFFINITY_CPU1=y

CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMSDU_TX_ENABLED=n
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=16

# Keep internal RAM for BT/DMA: only <=256 B mallocs stay internal, and the deep
# session/peer task stacks live in PSRAM (see psram_task.h).
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
